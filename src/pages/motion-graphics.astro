---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import VideoCard from '../components/VideoCard.astro';

// Sample motion graphics data (will be replaced by CMS)
const motionProjects = [
  {
    title: 'فيديو ترويجي',
    titleEn: 'Promotional Video',
    description: 'فيديو موشن جرافيك ترويجي لمنتج جديد مع تأثيرات متقدمة',
    descriptionEn: 'Motion graphics promotional video for new product with advanced effects',
    videoUrl: 'https://www.youtube.com/watch?v=dQw4w9WgXcQ',
    posterImage: '/uploads/motion1-poster.jpg'
  },
  {
    title: 'فيديو تعليمي',
    titleEn: 'Educational Video',
    description: 'فيديو تعليمي بأسلوب موشن جرافيك جذاب وسهل الفهم',
    descriptionEn: 'Educational video with attractive and easy-to-understand motion graphics',
    videoUrl: 'https://www.youtube.com/watch?v=dQw4w9WgXcQ',
    posterImage: '/uploads/motion2-poster.jpg'
  },
  {
    title: 'إنترو قناة يوتيوب',
    titleEn: 'YouTube Channel Intro',
    description: 'مقدمة احترافية لقناة يوتيوب بتصميم عصري',
    descriptionEn: 'Professional YouTube channel intro with modern design',
    videoUrl: 'https://www.youtube.com/watch?v=dQw4w9WgXcQ',
    posterImage: '/uploads/motion3-poster.jpg'
  }
];
---

<Layout title="Motion Graphics - RimbaPixel" lang="ar">
  <Navigation />
  
  <main class="pt-24">
    <!-- Page Header -->
    <section class="container mx-auto px-4 py-16">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-5xl font-bold mb-6 reveal">
          <span data-title-ar>موشن جرافيك</span>
          <span data-title-en class="hidden">Motion Graphics</span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 reveal">
          <span data-desc-ar>مجموعة من أعمالنا في مجال الموشن جرافيك من فيديوهات ترويجية وتعليمية ومقدمات</span>
          <span data-desc-en class="hidden">Collection of our motion graphics work including promotional, educational videos, and intros</span>
        </p>
      </div>
    </section>
    
    <!-- Videos Grid -->
    <section class="container mx-auto px-4 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {motionProjects.map((video) => (
          <VideoCard {...video} />
        ))}
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<script>
  function updateMotionGraphicsLanguage(lang: string) {
    const elements = [
      { ar: '[data-title-ar]', en: '[data-title-en]' },
      { ar: '[data-desc-ar]', en: '[data-desc-en]' }
    ];
    
    elements.forEach(({ ar, en }) => {
      const arEl = document.querySelector(ar);
      const enEl = document.querySelector(en);
      
      if (lang === 'ar') {
        arEl?.classList.remove('hidden');
        enEl?.classList.add('hidden');
      } else {
        arEl?.classList.add('hidden');
        enEl?.classList.remove('hidden');
      }
    });
  }
  
  document.addEventListener('DOMContentLoaded', () => {
    const currentLang = document.documentElement.getAttribute('lang') || 'ar';
    updateMotionGraphicsLanguage(currentLang);
  });
  
  const observer = new MutationObserver(() => {
    const currentLang = document.documentElement.getAttribute('lang') || 'ar';
    updateMotionGraphicsLanguage(currentLang);
  });
  
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['lang']
  });
</script>
