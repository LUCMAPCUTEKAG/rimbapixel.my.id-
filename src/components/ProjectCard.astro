---
interface Props {
  title: string;
  titleEn: string;
  description: string;
  descriptionEn: string;
  image: string;
  link?: string;
  category?: string;
}

const { title, titleEn, description, descriptionEn, image, link, category } = Astro.props;
---

<div class="reveal card-3d bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300">
  <div class="relative overflow-hidden group">
    <img
      src={image}
      alt={title}
      class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-110"
      loading="lazy"
    />
    {category && (
      <div class="absolute top-4 left-4 bg-blue-600 text-white px-3 py-1 rounded-full text-sm font-semibold">
        {category}
      </div>
    )}
  </div>
  
  <div class="p-6">
    <h3 class="text-xl font-bold mb-2 text-gray-900 dark:text-white">
      <span data-text-ar>{title}</span>
      <span data-text-en class="hidden">{titleEn}</span>
    </h3>
    <p class="text-gray-600 dark:text-gray-300 mb-4">
      <span data-text-ar>{description}</span>
      <span data-text-en class="hidden">{descriptionEn}</span>
    </p>
    
    {link && (
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:underline"
      >
        <span data-text-ar>عرض المشروع</span>
        <span data-text-en class="hidden">View Project</span>
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    )}
  </div>
</div>

<script>
  function updateCardLanguage(lang: string) {
    document.querySelectorAll('[data-text-ar], [data-text-en]').forEach(el => {
      const isArabic = el.hasAttribute('data-text-ar');
      
      if (lang === 'ar' && isArabic) {
        el.classList.remove('hidden');
      } else if (lang === 'en' && !isArabic) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });
  }
  
  document.addEventListener('DOMContentLoaded', () => {
    const currentLang = document.documentElement.getAttribute('lang') || 'ar';
    updateCardLanguage(currentLang);
  });
  
  const observer = new MutationObserver(() => {
    const currentLang = document.documentElement.getAttribute('lang') || 'ar';
    updateCardLanguage(currentLang);
  });
  
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['lang']
  });
</script>
