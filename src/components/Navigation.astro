---
const currentPath = Astro.url.pathname;

const navItems = {
  ar: [
    { href: '/', label: 'الرئيسية' },
    { href: '/graphic-design', label: 'تصميم جرافيكي' },
    { href: '/motion-graphics', label: 'موشن جرافيك' },
    { href: '/about', label: 'عنا' },
    { href: '/contact', label: 'اتصل بنا' },
  ],
  en: [
    { href: '/', label: 'Home' },
    { href: '/graphic-design', label: 'Graphic Design' },
    { href: '/motion-graphics', label: 'Motion Graphics' },
    { href: '/about', label: 'About' },
    { href: '/contact', label: 'Contact' },
  ],
};
---

<nav class="fixed top-0 w-full bg-white/80 dark:bg-gray-900/80 backdrop-blur-md z-50 shadow-sm">
  <div class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="text-2xl font-bold text-gray-900 dark:text-white">
        RimbaPixel
      </a>
      
      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-6">
        <ul class="flex gap-6" data-nav-list>
          {navItems.ar.map((item) => (
            <li>
              <a
                href={item.href}
                class={`text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors ${
                  currentPath === item.href ? 'text-blue-600 dark:text-blue-400 font-semibold' : ''
                }`}
                data-nav-link
                data-href={item.href}
              >
                <span data-label-ar>{item.label}</span>
                <span data-label-en class="hidden">{navItems.en.find(i => i.href === item.href)?.label}</span>
              </a>
            </li>
          ))}
        </ul>
        
        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          class="p-2 rounded-lg bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors"
          aria-label="Toggle theme"
        >
          <svg class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </button>
        
        <!-- Language Toggle -->
        <button
          id="lang-toggle"
          class="px-3 py-2 rounded-lg bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors font-semibold"
          aria-label="Toggle language"
        >
          <span data-lang-text>EN</span>
        </button>
      </div>
      
      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden p-2 rounded-lg bg-gray-200 dark:bg-gray-800"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
    
    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4">
      <ul class="flex flex-col gap-3" data-nav-list-mobile>
        {navItems.ar.map((item) => (
          <li>
            <a
              href={item.href}
              class={`block text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors ${
                currentPath === item.href ? 'text-blue-600 dark:text-blue-400 font-semibold' : ''
              }`}
              data-nav-link
              data-href={item.href}
            >
              <span data-label-ar>{item.label}</span>
              <span data-label-en class="hidden">{navItems.en.find(i => i.href === item.href)?.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="flex gap-3 mt-4">
        <button
          class="mobile-theme-toggle flex-1 p-2 rounded-lg bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors"
          aria-label="Toggle theme"
        >
          <span class="dark:hidden">🌙</span>
          <span class="hidden dark:inline">☀️</span>
        </button>
        <button
          class="mobile-lang-toggle flex-1 px-3 py-2 rounded-lg bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors font-semibold"
          aria-label="Toggle language"
        >
          <span data-lang-text-mobile>EN</span>
        </button>
      </div>
    </div>
  </div>
</nav>

<script>
  import '../styles/global.css';
  
  // Theme toggle functionality
  function toggleTheme() {
    const html = document.documentElement;
    const isDark = html.classList.contains('dark');
    
    if (isDark) {
      html.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      html.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  }
  
  // Language toggle functionality
  function toggleLanguage() {
    const html = document.documentElement;
    const currentLang = html.getAttribute('lang') || 'ar';
    const newLang = currentLang === 'ar' ? 'en' : 'ar';
    
    html.setAttribute('lang', newLang);
    html.setAttribute('dir', newLang === 'ar' ? 'rtl' : 'ltr');
    localStorage.setItem('lang', newLang);
    
    // Update UI text
    updateLanguageUI(newLang);
  }
  
  function updateLanguageUI(lang: string) {
    // Update language toggle button text
    document.querySelectorAll('[data-lang-text], [data-lang-text-mobile]').forEach(el => {
      el.textContent = lang === 'ar' ? 'EN' : 'AR';
    });
    
    // Update navigation labels
    document.querySelectorAll('[data-nav-link]').forEach(link => {
      const arLabel = link.querySelector('[data-label-ar]');
      const enLabel = link.querySelector('[data-label-en]');
      
      if (lang === 'ar') {
        arLabel?.classList.remove('hidden');
        enLabel?.classList.add('hidden');
      } else {
        arLabel?.classList.add('hidden');
        enLabel?.classList.remove('hidden');
      }
    });
  }
  
  // Mobile menu toggle
  function toggleMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    menu?.classList.toggle('hidden');
  }
  
  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    const currentLang = document.documentElement.getAttribute('lang') || 'ar';
    updateLanguageUI(currentLang);
    
    // Theme toggle listeners
    document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
    document.querySelectorAll('.mobile-theme-toggle').forEach(btn => {
      btn.addEventListener('click', toggleTheme);
    });
    
    // Language toggle listeners
    document.getElementById('lang-toggle')?.addEventListener('click', toggleLanguage);
    document.querySelectorAll('.mobile-lang-toggle').forEach(btn => {
      btn.addEventListener('click', toggleLanguage);
    });
    
    // Mobile menu toggle
    document.getElementById('mobile-menu-toggle')?.addEventListener('click', toggleMobileMenu);
  });
  
  // Handle page transitions
  document.addEventListener('astro:page-load', () => {
    const currentLang = document.documentElement.getAttribute('lang') || 'ar';
    updateLanguageUI(currentLang);
  });
</script>
